# نمونه تنظیمات سرور — مقادیر را به‌صورت متغیر محیطی export کنید
# مثال:  export SMS_PROVIDER=kavenegar  KAVENEGAR_API_KEY=xxxx

# پورت سرور
PORT=3000

# کلید امضای توکن — یک رشته تصادفی طولانی بگذارید!
SECRET=یک-رشته-تصادفی-طولانی-اینجا

# درگاه پیامک: dev | kavenegar | smsir
SMS_PROVIDER=dev

# --- کاوه‌نگار (https://kavenegar.com) ---
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# --- SMS.ir (https://sms.ir) ---
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_PARAM=CODE

# برند انتهای پیام کد تایید
BRAND=سوکوت
